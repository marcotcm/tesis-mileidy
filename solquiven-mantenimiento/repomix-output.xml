.home_container {
  display: flex;
  flex-direction: column;
  height: 100%;
  animation: fadeIn 0.5s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Espacios para los Logos */
.logos_header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem 0;
  margin-bottom: 2rem;
}

.logo_box {
  width: 120px;
  height: 60px;
  background-color: #f1f5f9;
  border: 2px dashed #cbd5e1;
  border-radius: 0.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo_box img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

.logo_hint {
  font-size: 0.65rem;
  color: #94a3b8;
  font-weight: 600;
  text-align: center;
}

/* Sección Hero Principal */
.hero_section {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 1rem;
}

.badge {
  background-color: #FFC107;
  color: #003882;
  font-weight: 800;
  font-size: 0.75rem;
  padding: 0.5rem 1rem;
  border-radius: 9999px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 1.5rem;
  box-shadow: 0 4px 6px rgba(255, 193, 7, 0.2);
}

.hero_title {
  font-size: 2rem;
  font-weight: 900;
  color: #0f172a;
  line-height: 1.2;
  margin-bottom: 1.5rem;
  max-width: 1000px;
}

@media (min-width: 768px) {
  .hero_title { font-size: 2.75rem; }
}

.text_accent {
  color: #003882; /* Azul principal */
}

.hero_subtitle {
  font-size: 1rem;
  color: #64748b;
  max-width: 650px;
  line-height: 1.6;
  margin-bottom: 2rem;
}

/* Sección del Carrusel */
.carousel_section {
  margin-top: 1rem;
  width: 100%;
}
